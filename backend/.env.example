# Copy this to .env and fill in real values before anything but solo local dev.

APP_NAME=LINEAGE API
ENV=development
DEBUG=true

# SQLite by default — zero setup. Switch to Postgres for anything shared:
# DATABASE_URL=postgresql+psycopg2://lineage:lineage@localhost:5432/lineage
DATABASE_URL=sqlite:///./data/lineage.db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATA_DIR=./data
UPLOADS_DIR=./data/uploads
MAX_UPLOAD_MB=500

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank for local dev — a key will be generated and persisted automatically.
FILE_ENCRYPTION_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Optional — if set, the Incident Report's summary is written by a real
# Claude API call instead of the deterministic template. Leave blank to use
# the deterministic version (always correct, just less fluent prose).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
PRELOAD_MODELS=true

# Optional search phrase generation. The investigator must consent in the UI
# before an image is sent to Gemini. LINEAGE does not fetch search results.
GEMINI_API_KEY=
GEMINI_SEARCH_MODEL=gemini-3.8-flash
MAX_WEB_SEARCHES_PER_MEDIA=3

# Phase 3A — Neo4j graph persistence (optional). Leave NEO4J_URI blank to use the
# in-memory KnowledgeGraph only. Never commit a real password; these stay server-side.
# With docker compose: NEO4J_URI=bolt://localhost:7687 (or bolt://neo4j:7687 inside compose)
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# NEO4J_CONNECT_TIMEOUT=3
# NEO4J_RETRY_SECONDS=30
# NEO4J_AUTO_SYNC=true

# Phase 3B — Investigation Copilot. Uses ANTHROPIC_API_KEY above. Set the provider to
# "none" (or leave the key blank) and the Copilot returns the retrieved graph/evidence
# context with a deterministic, grounded answer instead of calling an LLM.
COPILOT_LLM_PROVIDER=anthropic
COPILOT_MODEL=claude-opus-5-5
# COPILOT_MAX_TOKENS=4000

# Phase 2 geographic activity score (all optional; defaults shown). Thresholds apply to the 0-100 activity score.
# GEO_WEIGHT_OBSERVATIONS=3
# GEO_WEIGHT_UNIQUE_SOURCES=5
# GEO_WEIGHT_PROPAGATION_EVENTS=6
# GEO_HIGH_SCORE=60
# GEO_MEDIUM_SCORE=25
